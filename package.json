{
  "name": "jurasic-ranch",
  "version": "0.1.0",
  "private": true,
  "description": "Jurasic Ranch — offline-first PWA with baby dino waddle walks. Track 1: Trike Waddle Walk.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --ignore-pattern \"public/draco/**\" --ignore-pattern \"scripts/vendor/**\"",
    "format": "oxfmt index.html package.json vite.config.ts tsconfig.json src public '!public/draco/**'",
    "typecheck": "tsrs --noEmit",
    "verify": "pnpm lint && pnpm format --check && pnpm typecheck && pnpm test && pnpm build && node scripts/check-dist-clean.mjs"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^26.0.0",
    "@types/three": "^0.186.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsrs": "latest",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.15.0"
}
